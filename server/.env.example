# Copy to .env for local overrides. Every value has a sensible development default.
PORT=4000
# Required in production. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# SQLite database file (defaults to server/data/gripwise.db)
# DATABASE_FILE=./data/gripwise.db
# Set to true when running behind a reverse proxy (Render, Fly, Nginx...)
# TRUST_PROXY=true
