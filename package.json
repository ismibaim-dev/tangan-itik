{
  "name": "gripwise",
  "version": "2.0.0",
  "private": true,
  "description": "GripWise: guided carpal tunnel rehabilitation, an Android app with on-device storage",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "test": "npm test -w client",
    "typecheck": "npm run typecheck -w client",
    "android:sync": "npm run android:sync -w client",
    "android:apk": "npm run android:apk -w client"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
